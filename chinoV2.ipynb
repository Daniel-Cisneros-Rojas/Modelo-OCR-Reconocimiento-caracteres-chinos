        "# ==========================================================\n",
        "# MÓDULO 6\n",
        "# Generación del dataset\n",
        "# ==========================================================\n",
        "\n",
        "import shutil\n",
        "from pathlib import Path\n",
        "\n",
        "import cv2\n",
        "import numpy as np\n",
        "from tqdm.auto import tqdm\n",
        "\n",
        "# ==========================================================\n",
