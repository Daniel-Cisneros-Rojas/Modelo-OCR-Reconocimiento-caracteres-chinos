        "    labels=\"inferred\",\n",
        "    label_mode=\"int\",\n",
        "    color_mode=\"grayscale\",\n",
        "    image_size=IMAGE_SIZE,\n",
        "    batch_size=1,\n",
        "    shuffle=False\n",
        ")\n",
        "\n",
        "class_names = raw_dataset.class_names\n",
        "\n",
        "# ==========================================================\n",
        "# 3. GUARDAR LABELS.JSON\n",
        "# ==========================================================\n",
        "with open(LABELS_PATH, \"w\", encoding=\"utf-8\") as f:\n",
        "    json.dump(class_names, f, ensure_ascii=False, indent=4)\n",
        "\n",
        "print(\"✔ labels.json guardado\")\n",
        "\n",
        "# ==========================================================\n",
        "# 4. CREAR METADATA.JSON (usando tu CHARACTERS original)\n",
        "# ==========================================================\n",
        "character_map = {\n",
        "    c.hanzi: {\n",
        "        \"hanzi\": c.hanzi,\n",
        "        \"pinyin\": c.pinyin,\n",
        "        \"spanish\": c.spanish\n",
        "    }\n",
        "    for c in CHARACTERS\n",
        "}\n",
        "\n",
        "metadata = []\n",
        "\n",
        "for idx, hanzi in enumerate(class_names):\n",
