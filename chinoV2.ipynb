        "# ==========================================================\n",
        "# MÓDULO 3\n",
        "# Descarga automática de fuentes chinas\n",
        "# ==========================================================\n",
        "\n",
        "import os\n",
        "import requests\n",
        "from pathlib import Path\n",
        "from PIL import ImageFont\n",
        "from tqdm.auto import tqdm\n",
        "\n",
        "# ==========================================================\n",
        "# Dependencias\n",
        "# ==========================================================\n",
        "\n",
        "try:\n",
        "    import requests\n",
        "except ImportError:\n",
        "    !pip -q install requests\n",
        "    import requests\n",
        "\n",
        "try:\n",
        "    from tqdm.auto import tqdm\n",
        "except ImportError:\n",
        "    !pip -q install tqdm\n",
        "    from tqdm.auto import tqdm\n",
        "\n",
        "# ==========================================================\n",
        "# Configuración\n",
        "# ==========================================================\n",
        "\n",
        "FONTS_DIR.mkdir(parents=True, exist_ok=True)\n",
        "\n",
        "# Repositorios oficiales\n",
        "REPOSITORIES = [\n",
        "\n",
        "    (\n",
        "        \"googlefonts\",\n",
        "        \"noto-cjk\",\n",
        "        \"Sans/OTF/SimplifiedChinese\"\n",
        "    ),\n",
        "\n",
        "    (\n",
        "        \"adobe-fonts\",\n",
        "        \"source-han-sans\",\n",
        "        \"SubsetOTF/CN\"\n",
        "    )\n",
        "\n",
        "]\n",
        "\n",
        "# ==========================================================\n",
        "# Descargar lista de fuentes\n",
        "# ==========================================================\n",
        "\n",
        "def github_directory(owner, repo, path):\n",
        "\n",
        "    url = f\"https://api.github.com/repos/{owner}/{repo}/contents/{path}\"\n",
        "\n",
        "    response = requests.get(url)\n",
        "\n",
        "    if response.status_code != 200:\n",
        "\n",
        "        print(f\"No fue posible acceder a {repo}\")\n",
        "\n",
        "        return []\n",
        "\n",
        "    return response.json()\n",
        "\n",
        "\n",
        "# ==========================================================\n",
        "# Descargar archivo\n",
        "# ==========================================================\n",
        "\n",
        "def download_file(url, destination):\n",
        "\n",
        "    if destination.exists():\n",
        "        return\n",
        "\n",
        "    r = requests.get(url, stream=True)\n",
        "\n",
        "    r.raise_for_status()\n",
        "\n",
        "    with open(destination, \"wb\") as f:\n",
        "\n",
        "        for chunk in r.iter_content(8192):\n",
        "\n",
        "            if chunk:\n",
        "\n",
        "                f.write(chunk)\n",
        "\n",
        "\n",
        "# ==========================================================\n",
        "# Descarga\n",
        "# ==========================================================\n",
        "\n",
        "downloaded = 0\n",
        "\n",
        "print(\"=\" * 60)\n",
        "print(\"DESCARGANDO FUENTES\")\n",
        "print(\"=\" * 60)\n",
        "\n",
        "for owner, repo, path in REPOSITORIES:\n",
        "\n",
        "    files = github_directory(owner, repo, path)\n",
        "\n",
        "    if not files:\n",
        "        continue\n",
        "\n",
        "    print(f\"\\nRepositorio: {repo}\")\n",
        "\n",
        "    for file in tqdm(files):\n",
        "\n",
        "        name = file[\"name\"]\n",
        "\n",
        "        if not (\n",
        "            name.endswith(\".otf\")\n",
        "            or\n",
        "            name.endswith(\".ttf\")\n",
        "        ):\n",
        "            continue\n",
        "\n",
        "        destination = FONTS_DIR / name\n",
        "\n",
        "        download_file(\n",
        "\n",
        "            file[\"download_url\"],\n",
        "\n",
        "            destination\n",
        "\n",
        "        )\n",
        "\n",
        "        downloaded += 1\n",
        "\n",
        "print()\n",
        "\n",
        "print(f\"Descargadas: {downloaded}\")\n",
        "\n",
        "# ==========================================================\n",
        "# Validación\n",
        "# ==========================================================\n",
        "\n",
        "AVAILABLE_FONTS = []\n",
        "\n",
        "INVALID_FONTS = []\n",
        "\n",
        "for font in sorted(FONTS_DIR.iterdir()):\n",
        "\n",
        "    if font.suffix.lower() not in (\".ttf\", \".otf\"):\n",
        "        continue\n",
        "\n",
        "    try:\n",
        "\n",
        "        ImageFont.truetype(\n",
        "\n",
        "            str(font),\n",
        "\n",
        "            64\n",
        "\n",
        "        )\n",
        "\n",
        "        AVAILABLE_FONTS.append(font)\n",
        "\n",
        "    except Exception:\n",
        "\n",
        "        INVALID_FONTS.append(font)\n",
        "\n",
        "# ==========================================================\n",
        "# Resumen\n",
        "# ==========================================================\n",
        "\n",
        "print()\n",
