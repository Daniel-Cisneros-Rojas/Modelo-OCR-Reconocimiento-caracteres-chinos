        "    ChineseCharacter(\"女\",\"nǚ\",\"mujer\",\"Familia\"),\n",
        "    ChineseCharacter(\"父\",\"fù\",\"padre\",\"Familia\"),\n",
        "    ChineseCharacter(\"母\",\"mǔ\",\"madre\",\"Familia\"),\n",
        "    ChineseCharacter(\"子\",\"zǐ\",\"hijo\",\"Familia\"),\n",
        "    ChineseCharacter(\"兄\",\"xiōng\",\"hermano mayor\",\"Familia\"),\n",
        "    ChineseCharacter(\"姐\",\"jiě\",\"hermana mayor\",\"Familia\"),\n",
        "\n",
        "]\n",
        "\n",
        "# ==========================================================\n",
        "# Validación\n",
        "# ==========================================================\n",
        "\n",
        "hanzi_list = [c.hanzi for c in CHARACTERS]\n",
        "\n",
        "assert len(hanzi_list) == len(set(hanzi_list)), \\\n",
        "    \"Hay caracteres duplicados.\"\n",
        "\n",
        "# ==========================================================\n",
        "# Índices\n",
        "# ==========================================================\n",
        "\n",
        "CHAR_TO_INDEX = {\n",
        "    c.hanzi: i\n",
        "    for i, c in enumerate(CHARACTERS)\n",
        "}\n",
        "\n",
        "INDEX_TO_CHAR = {\n",
        "    i: c\n",
        "    for i, c in enumerate(CHARACTERS)\n",
        "}\n",
        "\n",
        "LABELS = [\n",
        "    c.hanzi\n",
        "    for c in CHARACTERS\n",
        "]\n",
        "\n",
        "NUM_CLASSES = len(CHARACTERS)\n",
        "\n",
        "# ==========================================================\n",
        "# Exportar labels.json\n",
        "# ==========================================================\n",
        "\n",
        "with open(\n",
        "    OUTPUT_DIR / LABELS_FILENAME,\n",
        "    \"w\",\n",
        "    encoding=\"utf8\"\n",
        ") as f:\n",
        "\n",
        "    json.dump(\n",
        "        LABELS,\n",
        "        f,\n",
        "        indent=4,\n",
        "        ensure_ascii=False\n",
        "    )\n",
        "\n",
        "# ==========================================================\n",
        "# Exportar metadata.json\n",
        "# ==========================================================\n",
        "\n",
        "metadata = []\n",
        "\n",
        "for idx, char in enumerate(CHARACTERS):\n",
        "\n",
        "    metadata.append({\n",
        "\n",
        "        \"index\": idx,\n",
        "\n",
        "        \"hanzi\": char.hanzi,\n",
        "\n",
        "        \"pinyin\": char.pinyin,\n",
        "\n",
        "        \"spanish\": char.spanish,\n",
        "\n",
        "        \"category\": char.category\n",
        "\n",
        "    })\n",
        "\n",
        "with open(\n",
        "    OUTPUT_DIR / METADATA_FILENAME,\n",
        "    \"w\",\n",
        "    encoding=\"utf8\"\n",
        ") as f:\n",
        "\n",
        "    json.dump(\n",
        "        metadata,\n",
        "        f,\n",
        "        indent=4,\n",
        "        ensure_ascii=False\n",
        "    )\n",
        "\n",
        "# ==========================================================\n",
        "# Resumen\n",
        "# ==========================================================\n",
        "\n",
        "print(\"=\"*60)\n",
        "\n",
        "print(\"REGISTRO DE CARACTERES\")\n",
        "\n",
        "print(\"=\"*60)\n",
        "\n",
        "print(f\"Total de clases : {NUM_CLASSES}\")\n",
        "\n",
        "print(f\"Primer carácter : {CHARACTERS[0]}\")\n",
        "\n",
        "print(f\"Último carácter : {CHARACTERS[-1]}\")\n",
        "\n",
        "print()\n",
        "\n",
        "print(\"✔ labels.json generado\")\n",
        "\n",
        "print(\"✔ metadata.json generado\")\n",
        "\n",
        "print(\"✔ Registro cargado correctamente\")\n",
        "\n",
        "print(\"=\"*60)"
