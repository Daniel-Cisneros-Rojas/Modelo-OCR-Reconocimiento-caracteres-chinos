        "# ==========================================================\n",
        "# MÓDULO 7\n",
        "# DataLoader optimizado para Google Colab\n",
        "# ==========================================================\n",
        "\n",
        "import tensorflow as tf\n",
        "\n",
        "print(\"=\" * 60)\n",
        "print(\"CREANDO DATASETS\")\n",
        "print(\"=\" * 60)\n",
        "\n",
        "# ==========================================================\n",
        "# Configuración\n",
        "# ==========================================================\n",
        "\n",
        "USE_CACHE = False\n",
        "SHUFFLE_BUFFER = 5000\n",
        "\n",
        "# ==========================================================\n",
        "# Dataset entrenamiento\n",
        "# ==========================================================\n",
        "\n",
        "train_dataset = tf.keras.utils.image_dataset_from_directory(\n",
        "\n",
        "    IMAGES_DIR,\n",
        "\n",
        "    labels=\"inferred\",\n",
        "\n",
        "    label_mode=\"int\",\n",
        "\n",
        "    color_mode=\"grayscale\",\n",
        "\n",
        "    image_size=IMAGE_SIZE,\n",
        "\n",
        "    batch_size=BATCH_SIZE,\n",
        "\n",
        "    validation_split=VALIDATION_SPLIT,\n",
        "\n",
        "    subset=\"training\",\n",
        "\n",
        "    seed=RANDOM_SEED\n",
        "\n",
        ")\n",
        "\n",
        "# IMPORTANTE:\n",
        "# Guardar los nombres ANTES de aplicar map()\n",
        "CLASS_NAMES = train_dataset.class_names\n",
        "\n",
        "# ==========================================================\n",
        "# Dataset validación\n",
        "# ==========================================================\n",
        "\n",
        "validation_dataset = tf.keras.utils.image_dataset_from_directory(\n",
        "\n",
        "    IMAGES_DIR,\n",
        "\n",
        "    labels=\"inferred\",\n",
        "\n",
        "    label_mode=\"int\",\n",
        "\n",
        "    color_mode=\"grayscale\",\n",
        "\n",
        "    image_size=IMAGE_SIZE,\n",
        "\n",
        "    batch_size=BATCH_SIZE,\n",
        "\n",
        "    validation_split=VALIDATION_SPLIT,\n",
        "\n",
        "    subset=\"validation\",\n",
        "\n",
        "    seed=RANDOM_SEED\n",
        "\n",
        ")\n",
        "\n",
        "# ==========================================================\n",
        "# Verificación\n",
        "# ==========================================================\n",
        "\n",
        "assert len(CLASS_NAMES) == NUM_CLASSES, (\n",
        "    f\"Se esperaban {NUM_CLASSES} clases \"\n",
        "    f\"pero TensorFlow detectó {len(CLASS_NAMES)}.\"\n",
        ")\n",
        "\n",
        "# ==========================================================\n",
        "# Preprocesamiento\n",
        "# ==========================================================\n",
        "\n",
        "def preprocess(images, labels):\n",
        "\n",
        "    # uint8 -> float32\n",
        "    images = tf.cast(images, tf.float32) / 255.0\n",
        "\n",
        "    # Gray -> RGB\n",
        "    images = tf.image.grayscale_to_rgb(images)\n",
        "\n",
        "    return images, labels\n",
        "\n",
        "# ==========================================================\n",
        "# Pipeline entrenamiento\n",
        "# ==========================================================\n",
        "\n",
        "train_dataset = (\n",
        "\n",
        "    train_dataset\n",
        "\n",
        "    .shuffle(\n",
        "\n",
        "        SHUFFLE_BUFFER,\n",
        "\n",
        "        seed=RANDOM_SEED,\n",
        "\n",
        "        reshuffle_each_iteration=True\n",
        "\n",
        "    )\n",
        "\n",
        "    .map(\n",
        "\n",
        "        preprocess,\n",
        "\n",
        "        num_parallel_calls=AUTOTUNE\n",
        "\n",
        "    )\n",
        "\n",
        ")\n",
        "\n",
        "# ==========================================================\n",
        "# Pipeline validación\n",
        "# ==========================================================\n",
        "\n",
        "validation_dataset = (\n",
        "\n",
        "    validation_dataset\n",
        "\n",
        "    .map(\n",
        "\n",
        "        preprocess,\n",
        "\n",
        "        num_parallel_calls=AUTOTUNE\n",
        "\n",
        "    )\n",
        "\n",
        ")\n",
        "\n",
        "# ==========================================================\n",
        "# Cache opcional\n",
        "# ==========================================================\n",
        "\n",
        "if USE_CACHE:\n",
        "\n",
        "    train_dataset = train_dataset.cache()\n",
        "\n",
        "    validation_dataset = validation_dataset.cache()\n",
        "\n",
        "# ==========================================================\n",
        "# Prefetch\n",
        "# ==========================================================\n",
        "\n",
        "train_dataset = train_dataset.prefetch(AUTOTUNE)\n",
        "\n",
        "validation_dataset = validation_dataset.prefetch(AUTOTUNE)\n",
        "\n",
        "# ==========================================================\n",
        "# Resumen\n",
        "# ==========================================================\n",
        "\n",
        "print()\n",
        "\n",
        "print(\"=\" * 60)\n",
        "print(\"DATASETS CREADOS\")\n",
        "print(\"=\" * 60)\n",
        "\n",
        "print(f\"Número de clases : {NUM_CLASSES}\")\n",
        "print(f\"Batch size       : {BATCH_SIZE}\")\n",
        "print(f\"Resolución       : {IMAGE_SIZE}\")\n",
        "\n",
        "print()\n",
        "\n",
        "print(\"Primeras clases:\")\n",
        "\n",
        "for name in CLASS_NAMES[:10]:\n",
        "    print(\" •\", name)\n",
        "\n",
        "print()\n",
        "\n",
        "print(f\"Total clases detectadas : {len(CLASS_NAMES)}\")\n",
        "\n",
        "print()\n",
        "\n",
        "print(\"✔ DataLoader preparado correctamente\")\n",
        "\n",
        "print(\"=\" * 60)"
      ],
