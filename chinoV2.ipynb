        "# ==========================================================\n",
        "# MÓDULO 2\n",
        "# Registro de caracteres\n",
        "# ==========================================================\n",
        "\n",
        "from dataclasses import dataclass, asdict\n",
        "import json\n",
        "\n",
        "# ==========================================================\n",
        "# Clase\n",
        "# ==========================================================\n",
        "\n",
        "@dataclass\n",
        "class ChineseCharacter:\n",
        "\n",
        "    hanzi: str\n",
        "    pinyin: str\n",
        "    spanish: str\n",
        "    category: str\n",
        "\n",
        "\n",
        "# ==========================================================\n",
        "# Base de datos\n",
        "# ==========================================================\n",
        "\n",
        "CHARACTERS = [\n",
        "\n",
        "    # ---------------- Animales ----------------\n",
