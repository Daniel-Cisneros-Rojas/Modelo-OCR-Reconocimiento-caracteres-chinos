        "    ChineseCharacter(\"院\",\"yuàn\",\"hospital\",\"Edificios\"),\n",
        "    ChineseCharacter(\"馆\",\"guǎn\",\"edificio\",\"Edificios\"),\n",
        "    ChineseCharacter(\"楼\",\"lóu\",\"edificio alto\",\"Edificios\"),\n",
        "    ChineseCharacter(\"桥\",\"qiáo\",\"puente\",\"Edificios\"),\n",
        "\n",
        "    # ---------------- Naturaleza ----------------\n",
        "\n",
        "    ChineseCharacter(\"山\",\"shān\",\"montaña\",\"Naturaleza\"),\n",
        "    ChineseCharacter(\"水\",\"shuǐ\",\"agua\",\"Naturaleza\"),\n",
        "    ChineseCharacter(\"火\",\"huǒ\",\"fuego\",\"Naturaleza\"),\n",
        "    ChineseCharacter(\"木\",\"mù\",\"árbol\",\"Naturaleza\"),\n",
        "    ChineseCharacter(\"土\",\"tǔ\",\"tierra\",\"Naturaleza\"),\n",
        "    ChineseCharacter(\"风\",\"fēng\",\"viento\",\"Naturaleza\"),\n",
        "    ChineseCharacter(\"雨\",\"yǔ\",\"lluvia\",\"Naturaleza\"),\n",
        "    ChineseCharacter(\"云\",\"yún\",\"nube\",\"Naturaleza\"),\n",
        "\n",
        "    # ---------------- Objetos ----------------\n",
        "\n",
        "    ChineseCharacter(\"书\",\"shū\",\"libro\",\"Objetos\"),\n",
        "    ChineseCharacter(\"门\",\"mén\",\"puerta\",\"Objetos\"),\n",
        "    ChineseCharacter(\"车\",\"chē\",\"automóvil\",\"Objetos\"),\n",
        "    ChineseCharacter(\"桌\",\"zhuō\",\"mesa\",\"Objetos\"),\n",
        "    ChineseCharacter(\"椅\",\"yǐ\",\"silla\",\"Objetos\"),\n",
        "    ChineseCharacter(\"笔\",\"bǐ\",\"lápiz\",\"Objetos\"),\n",
        "    ChineseCharacter(\"杯\",\"bēi\",\"vaso\",\"Objetos\"),\n",
        "    ChineseCharacter(\"伞\",\"sǎn\",\"paraguas\",\"Objetos\"),\n",
        "    ChineseCharacter(\"钟\",\"zhōng\",\"reloj\",\"Objetos\"),\n",
        "\n",
        "    # ---------------- Familia ----------------\n",
        "\n",
