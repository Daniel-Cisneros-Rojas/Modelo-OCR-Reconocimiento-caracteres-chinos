        "if RECREATE_DATASET and IMAGES_DIR.exists():\n",
        "\n",
        "    shutil.rmtree(IMAGES_DIR)\n",
        "\n",
        "IMAGES_DIR.mkdir(parents=True, exist_ok=True)\n",
        "\n",
        "# ==========================================================\n",
        "# Contador\n",
        "# ==========================================================\n",
        "\n",
        "total_images = 0\n",
