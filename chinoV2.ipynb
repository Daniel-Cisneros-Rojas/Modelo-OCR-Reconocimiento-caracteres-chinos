      "cell_type": "code",
      "source": [
        "# ==========================================================\n",
        "# MÓDULO 5\n",
        "# Pipeline profesional\n",
        "# Compatible con Albumentations 2.x\n",
        "# ==========================================================\n",
        "\n",
        "import albumentations as A\n",
        "import numpy as np\n",
        "import cv2\n",
        "\n",
        "# ==========================================================\n",
        "# Pipeline\n",
        "# ==========================================================\n",
        "\n",
        "augmentation_pipeline = A.Compose([\n",
        "\n",
        "    # ------------------------------------------------------\n",
        "    # Transformaciones geométricas\n",
        "    # ------------------------------------------------------\n",
        "\n",
        "    A.Affine(\n",
        "\n",
        "        scale=(0.92, 1.08),\n",
        "\n",
        "        translate_percent=(-0.05, 0.05),\n",
        "\n",
        "        rotate=(-10, 10),\n",
        "\n",
        "        shear=(-4, 4),\n",
        "\n",
        "        border_mode=cv2.BORDER_CONSTANT,\n",
        "\n",
        "        fill=255,\n",
        "\n",
        "        p=0.90\n",
        "\n",
        "    ),\n",
        "\n",
        "    # ------------------------------------------------------\n",
        "\n",
        "    A.ElasticTransform(\n",
        "\n",
        "        alpha=20,\n",
        "\n",
        "        sigma=6,\n",
        "\n",
        "        p=0.50\n",
        "\n",
        "    ),\n",
        "\n",
        "    # ------------------------------------------------------\n",
        "\n",
        "    A.GridDistortion(\n",
        "\n",
        "        num_steps=5,\n",
        "\n",
        "        distort_limit=0.12,\n",
        "\n",
        "        p=0.40\n",
        "\n",
        "    ),\n",
        "\n",
        "    # ------------------------------------------------------\n",
        "\n",
        "    A.Perspective(\n",
        "\n",
        "        scale=(0.02,0.05),\n",
        "\n",
        "        keep_size=True,\n",
        "\n",
        "        fill=255,\n",
        "\n",
        "        p=0.35\n",
        "\n",
        "    ),\n",
        "\n",
        "    # ------------------------------------------------------\n",
        "    # Calidad de imagen\n",
        "    # ------------------------------------------------------\n",
        "\n",
        "    A.OneOf([\n",
        "\n",
        "        A.GaussianBlur(\n",
        "\n",
        "            blur_limit=(3,5),\n",
        "\n",
        "            p=1\n",
        "\n",
        "        ),\n",
        "\n",
        "        A.MedianBlur(\n",
        "\n",
        "            blur_limit=3,\n",
        "\n",
        "            p=1\n",
        "\n",
        "        ),\n",
        "\n",
        "    ], p=0.30),\n",
        "\n",
        "    # ------------------------------------------------------\n",
        "\n",
        "    A.GaussNoise(\n",
        "\n",
        "        std_range=(0.02,0.05),\n",
        "\n",
        "        mean_range=(0.0,0.0),\n",
        "\n",
        "        p=0.40\n",
        "\n",
        "    ),\n",
        "\n",
        "    # ------------------------------------------------------\n",
        "\n",
        "    A.RandomBrightnessContrast(\n",
        "\n",
        "        brightness_limit=0.10,\n",
        "\n",
        "        contrast_limit=0.15,\n",
        "\n",
        "        p=0.50\n",
        "\n",
        "    ),\n",
        "\n",
        "])\n",
        "\n",
        "# ==========================================================\n",
        "# Función principal\n",
        "# ==========================================================\n",
        "\n",
        "def augment(image):\n",
        "\n",
        "    \"\"\"\n",
        "    image : numpy uint8\n",
        "    \"\"\"\n",
        "\n",
        "    result = augmentation_pipeline(\n",
        "\n",
        "        image=image\n",
        "\n",
        "    )\n",
        "\n",
        "    return result[\"image\"]"
      ],
      "metadata": {
        "id": "hGtjJCbSX0YB"
      },
      "execution_count": 25,
      "outputs": []
