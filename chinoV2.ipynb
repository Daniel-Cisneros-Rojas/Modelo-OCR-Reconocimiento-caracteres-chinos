      "cell_type": "code",
      "source": [
        "# ==========================================================\n",
        "# MÓDULO 4\n",
        "# Renderizador profesional V2\n",
        "# Compatible con Google Colab\n",
        "# ==========================================================\n",
        "\n",
        "import random\n",
        "import numpy as np\n",
        "\n",
        "from PIL import (\n",
        "    Image,\n",
        "    ImageDraw,\n",
        "    ImageFont\n",
        ")\n",
        "\n",
        "# ==========================================================\n",
        "# Configuración\n",
        "# ==========================================================\n",
        "\n",
        "START_FONT_SIZE = 110\n",
        "\n",
        "MIN_FONT_SIZE = 55\n",
        "\n",
        "SAFE_MARGIN = 12\n",
        "\n",
        "MAX_OFFSET = 3\n",
        "\n",
        "# ==========================================================\n",
        "# Fuente aleatoria\n",
        "# ==========================================================\n",
        "\n",
        "def random_font(size):\n",
        "\n",
        "    font_path = random.choice(AVAILABLE_FONTS)\n",
        "\n",
        "    return ImageFont.truetype(\n",
        "        str(font_path),\n",
        "        size=size\n",
        "    )\n",
        "\n",
        "# ==========================================================\n",
        "# Encontrar tamaño adecuado\n",
        "# ==========================================================\n",
        "\n",
        "def fit_font(draw, hanzi):\n",
        "\n",
        "    size = START_FONT_SIZE\n",
        "\n",
        "    while size >= MIN_FONT_SIZE:\n",
        "\n",
        "        font = random_font(size)\n",
        "\n",
        "        bbox = draw.textbbox(\n",
        "            (0,0),\n",
        "            hanzi,\n",
        "            font=font\n",
        "        )\n",
        "\n",
        "        left, top, right, bottom = bbox\n",
        "\n",
        "        width = right-left\n",
        "        height = bottom-top\n",
        "\n",
        "        if (\n",
        "            width <= IMAGE_SIZE[0]-SAFE_MARGIN*2\n",
        "            and\n",
        "            height <= IMAGE_SIZE[1]-SAFE_MARGIN*2\n",
        "        ):\n",
        "\n",
        "            return font, bbox\n",
        "\n",
        "        size -= 2\n",
        "\n",
        "    raise RuntimeError(\n",
        "        \"No fue posible ajustar el carácter.\"\n",
        "    )\n",
        "\n",
        "# ==========================================================\n",
        "# Render\n",
        "# ==========================================================\n",
        "\n",
        "def render_character(hanzi):\n",
        "\n",
        "    image = Image.new(\n",
        "\n",
        "        \"L\",\n",
        "\n",
        "        IMAGE_SIZE,\n",
        "\n",
        "        BACKGROUND_COLOR\n",
        "\n",
        "    )\n",
        "\n",
        "    draw = ImageDraw.Draw(image)\n",
        "\n",
        "    font, bbox = fit_font(\n",
        "\n",
        "        draw,\n",
        "\n",
        "        hanzi\n",
        "\n",
        "    )\n",
        "\n",
        "    left, top, right, bottom = bbox\n",
        "\n",
        "    width = right-left\n",
        "    height = bottom-top\n",
        "\n",
        "    # ======================================================\n",
        "    # Centro exacto\n",
        "    # ======================================================\n",
        "\n",
        "    x = (IMAGE_SIZE[0]-width)/2-left\n",
        "\n",
        "    y = (IMAGE_SIZE[1]-height)/2-top\n",
        "\n",
        "    # ======================================================\n",
        "    # Variación pequeña\n",
        "    # ======================================================\n",
        "\n",
        "    x += random.randint(\n",
        "        -MAX_OFFSET,\n",
        "        MAX_OFFSET\n",
        "    )\n",
        "\n",
        "    y += random.randint(\n",
        "        -MAX_OFFSET,\n",
        "        MAX_OFFSET\n",
        "    )\n",
        "\n",
        "    draw.text(\n",
        "\n",
        "        (x,y),\n",
        "\n",
        "        hanzi,\n",
        "\n",
        "        fill=FOREGROUND_COLOR,\n",
        "\n",
        "        font=font\n",
        "\n",
        "    )\n",
        "\n",
        "    return np.array(image)\n",
        "\n",
        "# ==========================================================\n",
        "# Test\n",
        "# ==========================================================\n",
        "\n",
        "print(\"=\"*60)\n",
        "print(\"PROBANDO RENDERIZADOR\")\n",
        "print(\"=\"*60)\n",
        "\n",
        "sample = render_character(\"猫\")\n",
        "\n",
        "print(sample.shape)\n",
        "\n",
        "print(sample.dtype)\n",
        "\n",
        "print(\"OK\")"
      ],
