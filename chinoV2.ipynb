        "    ChineseCharacter(\"猫\",\"māo\",\"gato\",\"Animales\"),\n",
        "    ChineseCharacter(\"狗\",\"gǒu\",\"perro\",\"Animales\"),\n",
        "    ChineseCharacter(\"鸟\",\"niǎo\",\"pájaro\",\"Animales\"),\n",
        "    ChineseCharacter(\"鱼\",\"yú\",\"pez\",\"Animales\"),\n",
        "    ChineseCharacter(\"马\",\"mǎ\",\"caballo\",\"Animales\"),\n",
        "    ChineseCharacter(\"牛\",\"niú\",\"vaca\",\"Animales\"),\n",
        "    ChineseCharacter(\"羊\",\"yáng\",\"oveja\",\"Animales\"),\n",
