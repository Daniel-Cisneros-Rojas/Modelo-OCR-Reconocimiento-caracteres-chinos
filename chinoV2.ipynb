        "\n",
        "print(\"✔ Exportando modelo...\")\n",
        "\n",
        "# ==========================================================\n",
        "# 1. GUARDAR MODELO\n",
        "# ==========================================================\n",
        "model.save(MODEL_PATH)\n",
        "\n",
        "print(\"✔ model.keras guardado\")\n",
        "\n",
        "# ==========================================================\n",
        "# 2. OBTENER ORDEN REAL DE CLASES (CRÍTICO)\n",
        "# ==========================================================\n",
        "raw_dataset = tf.keras.utils.image_dataset_from_directory(\n",
