        "    ChineseCharacter(\"兔\",\"tù\",\"conejo\",\"Animales\"),\n",
        "\n",
        "    # ---------------- Profesiones ----------------\n",
        "\n",
        "    ChineseCharacter(\"医\",\"yī\",\"médico\",\"Profesiones\"),\n",
        "    ChineseCharacter(\"师\",\"shī\",\"maestro\",\"Profesiones\"),\n",
        "    ChineseCharacter(\"警\",\"jǐng\",\"policía\",\"Profesiones\"),\n",
        "    ChineseCharacter(\"厨\",\"chú\",\"cocinero\",\"Profesiones\"),\n",
        "    ChineseCharacter(\"工\",\"gōng\",\"obrero\",\"Profesiones\"),\n",
        "    ChineseCharacter(\"农\",\"nóng\",\"agricultor\",\"Profesiones\"),\n",
        "    ChineseCharacter(\"画\",\"huà\",\"pintor\",\"Profesiones\"),\n",
